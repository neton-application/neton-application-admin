VITE_BASE=/

# 请求路径
VITE_BASE_URL=http://127.0.0.1:8080
# 接口地址
VITE_GLOB_API_URL=http://127.0.0.1:8080/admin-api
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 验证码的开关。
# 关掉：后端根本没有 /system/captcha/get（线上 404），拼图图片是空白的，滑到底也过不了，
# 等于把管理员挡在门外。真要上验证码得先有服务端实现。
VITE_APP_CAPTCHA_ENABLE=false